# ============================================
# Verus CRM - Variáveis de ambiente (Railway)
# Copie este arquivo para .env e preencha os valores
# ============================================

# Banco de dados PostgreSQL
# No Railway: adicione o plugin PostgreSQL e use a variável ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://user:password@host:5432/railway"

# Segredo de autenticação (NextAuth v5)
# Gere com: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_SECRET=""

# URL pública da aplicação (o domínio do Railway ou seu domínio próprio)
# Ex.: https://verus.up.railway.app  ou  https://verusapp.com.br
NEXTAUTH_URL="https://seu-app.up.railway.app"

# Chave da API de IA (compatível com OpenAI)
# Opção A: manter a chave da Abacus.AI (endpoint https://apps.abacus.ai/v1/chat/completions)
# Opção B: trocar para OpenAI (veja RAILWAY_SETUP.md, seção "IA")
ABACUSAI_API_KEY=""
